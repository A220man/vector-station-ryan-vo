# VoiceStudio Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=VoiceStudio
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
# SQLite for development, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./voicestudio.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/voicestudio

# Security
# Generate a secure secret key for production: openssl rand -hex 32
SECRET_KEY=dev-secret-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OIDC / Keycloak
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8080/realms/voicestudio
OIDC_CLIENT_ID=voicestudio-frontend
OIDC_CLIENT_SECRET=voicestudio-frontend-secret
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_SCOPES=openid,profile,email

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=

# Audio
AUDIO_SAMPLE_RATE=22050
AUDIO_OUTPUT_FORMAT=wav
MAX_TEXT_LENGTH=5000

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Keycloak (for docker-compose)
KEYCLOAK_ADMIN_PASSWORD=admin